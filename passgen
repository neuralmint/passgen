#!/usr/bin/env python3
"""passgen — secure password & passphrase generator for the terminal.

Uses the canonical BIP-39 2048-word list (11 bits/word) instead of a
hand-pasted wordlist. Offers a deterministic "derive" mode via SHA-256.

Usage:
    passgen                    20-char random password
    passgen -l 32              32-char
    passgen -s                 include symbols
    passgen -n 5               generate 5
    passgen phrase -w 6        BIP-39 passphrase, 6 words
    passgen derive -w 4 -l 20  BIP39 words -> SHA256 -> trim -> random swaps
    passgen pin -l 8           8-digit PIN
"""
import argparse
import hashlib
import math
import random
import secrets
import string
import sys

from bip39_words import BIP39_WORDS

DEFAULT_LENGTH = 20
WORD_BITS = 11  # log2(2048)

_SYMBOLS = "!@#$%^&*()-_=+[]{}|;:,.<>?"


def _random_words(n):
    return [secrets.choice(BIP39_WORDS) for _ in range(n)]


def generate_password(length=DEFAULT_LENGTH, symbols=False):
    chars = string.ascii_letters + string.digits
    if symbols:
        chars += _SYMBOLS
    pwd = [
        secrets.choice(string.ascii_lowercase),
        secrets.choice(string.ascii_uppercase),
        secrets.choice(string.digits),
    ]
    if symbols:
        pwd.append(secrets.choice("!@#$%^&*"))
    pwd.extend(secrets.choice(chars) for _ in range(length - len(pwd)))
    secret = secrets.SystemRandom()
    for i in range(len(pwd) - 1, 0, -1):
        j = secret.randrange(i + 1)
        pwd[i], pwd[j] = pwd[j], pwd[i]
    return ''.join(pwd)


def generate_passphrase(word_count=4):
    return '-'.join(w.capitalize() for w in _random_words(word_count))


def generate_derived(word_count=4, length=DEFAULT_LENGTH, swaps=3, seed=None):
    """BIP39 words -> SHA256 -> slice to `length` -> `swaps` random letter swaps.

    `seed` pins the words deterministically (reproducible output). Without it,
    words come from secrets, so output is unique per run.
    """
    if seed is not None:
        # deterministic: derive words from the seed string
        h = hashlib.sha256(seed.encode()).digest()
        words = [BIP39_WORDS[int.from_bytes(h[i:i + 2], 'big') & 0x7FF]
                 for i in range(0, word_count * 2, 2)]
    else:
        words = _random_words(word_count)

    rng = secrets.SystemRandom()
    digest = hashlib.sha256(' '.join(words).encode()).hexdigest()  # 64 hex chars

    # cut a contiguous slice of `length` from a random position (from each end)
    avail = len(digest) - length
    start = rng.randrange(avail + 1) if avail >= 0 else 0
    base = digest[start:start + length]
    if avail < 0:  # need more chars than digest: repeat it
        base = (digest * 2)[:length]

    parts = list(base)
    positions = rng.sample(range(len(parts)), k=min(swaps, len(parts)))
    for idx in positions:
        parts[idx] = rng.choice(string.ascii_letters + string.digits)
    pwd = ''.join(parts)

    bits = word_count * WORD_BITS
    return pwd, bits, words


def generate_pin(length=6):
    return ''.join(str(secrets.randbelow(10)) for _ in range(length))


def entropy(pwd):
    charset = 0
    if any(c.islower() for c in pwd): charset += 26
    if any(c.isupper() for c in pwd): charset += 26
    if any(c.isdigit() for c in pwd): charset += 10
    if any(c in _SYMBOLS for c in pwd): charset += 30
    return round(len(pwd) * math.log2(max(charset, 1)), 1)


def main():
    parser = argparse.ArgumentParser(description="Secure password generator")
    parser.add_argument("mode", nargs="?", default="password",
                        choices=["password", "phrase", "derive", "pin"])
    parser.add_argument("-l", "--length", type=int)
    parser.add_argument("-s", "--symbols", action="store_true")
    parser.add_argument("-n", "--count", type=int, default=1)
    parser.add_argument("-w", "--words", type=int, default=4)
    parser.add_argument("--swaps", type=int, default=3, help="derive: random letter swaps")
    parser.add_argument("--seed", help="derive: deterministic seed string")
    args = parser.parse_args()

    for i in range(args.count):
        if args.mode == "phrase":
            wc = args.length if args.length else args.words
            pwd = generate_passphrase(wc)
            label = f"[{wc * WORD_BITS} bits]"
        elif args.mode == "derive":
            wc = args.words
            ln = args.length if args.length else DEFAULT_LENGTH
            sw = args.swaps
            pwd, bits, words = generate_derived(wc, ln, sw, args.seed)
            label = f"[{bits} bits seed, {ln} chars, {sw} swaps]"
        elif args.mode == "pin":
            ln = args.length if args.length else 6
            pwd = generate_pin(ln)
            label = ""
        else:
            ln = args.length if args.length else DEFAULT_LENGTH
            pwd = generate_password(ln, args.symbols)
            label = f"[{entropy(pwd)} bits]"

        if args.count > 1:
            print(f"{i + 1:>3}.  {pwd}  {label}")
        else:
            print(pwd)
            if label:
                print(label)


if __name__ == "__main__":
    main()