DEFAULT_LENGTH = 20

def generate_password(length=DEFAULT_LENGTH, symbols=False):
    chars = string.ascii_letters + string.digits
    if symbols:
        chars += "!@#$%^&*()-_=+[]{}|;:,.<>?"
    
    # Ensure at least one of each type
    password = [
        secrets.choice(string.ascii_lowercase),
        secrets.choice(string.ascii_uppercase),
        secrets.choice(string.digits),
    ]
    if symbols:
        password.append(secrets.choice("!@#$%^&*"))
    
    remaining = length - len(password)
    password.extend(secrets.choice(chars) for _ in range(remaining))
    secrets.SystemRandom().shuffle(password)
    return ''.join(password)

def generate_passphrase(word_count=4):
    selected = [secrets.choice(WORDS).capitalize() for _ in range(word_count)]
    return '-'.join(selected)

def generate_pin(length=6):
    return ''.join(str(secrets.randbelow(10)) for _ in range(length))

def entropy(password):
    """Estimate entropy bits."""
    charset = 0
    if any(c.islower() for c in password): charset += 26
    if any(c.isupper() for c in password): charset += 26
    if any(c.isdigit() for c in password): charset += 10
    if any(c in "!@#$%^&*()-_=+[]{}|;:,.<>?" for c in password): charset += 30
    return round(len(password) * math.log2(max(charset, 1)), 1)

def main():
    parser = argparse.ArgumentParser(description="Secure password generator")
    parser.add_argument("mode", nargs="?", default="password",
                        choices=["password", "phrase", "pin"],
                        help="password, phrase, or pin")
    parser.add_argument("-l", "--length", type=int, help="length")
    parser.add_argument("-s", "--symbols", action="store_true", help="include symbols")
    parser.add_argument("-n", "--count", type=int, default=1, help="number to generate")
    parser.add_argument("-w", "--words", type=int, default=4, help="word count for phrase")
    
    args = parser.parse_args()
    
    for i in range(args.count):
        if args.mode == "phrase":
            wc = args.length if args.length else args.words
            pwd = generate_passphrase(wc)
        elif args.mode == "pin":
            ln = args.length if args.length else 6
            pwd = generate_pin(ln)
        else:
            ln = args.length if args.length else DEFAULT_LENGTH
            pwd = generate_password(ln, args.symbols)
        
        ent = entropy(pwd)
        label = f"[{ent} bits]" if args.mode != "pin" else ""
        if args.count > 1:
            print(f"{i+1:>3}.  {pwd}  {label}")
        else:
            print(pwd)
            if ent:
                print(f"({ent} bits of entropy)")
    
    if args.count > 1:
        print(f"\nDonations: {ETH_ADDR} (ETH)")

if __name__ == "__main__":
